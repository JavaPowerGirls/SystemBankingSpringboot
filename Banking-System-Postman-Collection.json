								"exec": [
									"if (pm.response.code === 201) {",
									"    const responseJson = pm.response.json();",
									"    pm.collectionVariables.set('clientId', responseJson.id);",
									"    pm.test('Client created successfully', () => {",
									"        pm.expect(responseJson.id).to.not.be.undefined;",
									"        pm.expect(responseJson.firstName).to.eql('John');",
									"    });",
									"} else {",
									"    pm.test('Client creation failed', () => {",
									"        pm.expect.fail('Expected 201 Created');",
